# Copy this file to .env and fill in your real values.
# This file contains placeholders only — do not commit real secrets.

# -----------------------------------------------------------------------------
# n8n instance configuration
# -----------------------------------------------------------------------------
# Required for encrypting saved credentials in self-hosted n8n.
# Generate a strong random value, e.g.:
#   openssl rand -base64 32
N8N_ENCRYPTION_KEY=change-me-to-a-strong-random-string

# Public URL where this n8n instance is reachable (used for webhooks).
N8N_PUBLIC_URL=https://n8n.example.com


# -----------------------------------------------------------------------------
# Vector store configuration (Qdrant)
# -----------------------------------------------------------------------------
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_PRODUCTS_COLLECTION=woocommerce-products
QDRANT_POLICIES_COLLECTION=woocommerce-policies

# -----------------------------------------------------------------------------
# Store and messaging service configuration
# -----------------------------------------------------------------------------
WOOCOMMERCE_BASE_URL=https://your-store.com
EVOLUTION_API_BASE_URL=http://evolution-api:8080

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# Real API keys (OpenAI, OpenRouter, Qdrant, WooCommerce, Evolution) must be
# configured as native n8n credentials inside the n8n UI, not in this file.
#
# The WhatsApp webhook path is a shared secret and must be regenerated inside
# the "WhatsApp Inbound" Webhook node in the n8n UI. Do not store it here.
