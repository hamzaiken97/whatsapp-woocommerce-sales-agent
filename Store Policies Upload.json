                  },
                  {
                    "option": "About us"
                  },
                  {
                    "option": "Shipping & delivery"
                  },
                  {
                    "option": "Returns & refunds"
                  },
                  {
                    "option": "Payment"
                  },
                  {
                    "option": "FAQ"
                  },
                  {
                    "option": "Other"
