    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ $('KB Config — EDIT ME').item.json.qdrantUrl }}/collections/{{ $('KB Config — EDIT ME').item.json.collection }}/index?wait=true",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "qdrantApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ field_name: 'metadata.doc_title', field_schema: 'keyword' }) }}",
        "options": {
          "response": {
