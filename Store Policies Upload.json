              "neverError": true
            }
          }
        }
      },
      "id": "da25ab2c-8424-44b0-bba6-6ed881c32ca3",
      "name": "Ensure Doc-Title Index",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2800,
        528
      ],
      "notesInFlow": true,
      "credentials": {
        "qdrantApi": {
          "id": "hr9diS9lk4umgh9s",
          "name": "Qdrant account"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Qdrant only allows filtering on payload fields that have an index. Deleting the previous version of a document filters by metadata.doc_title, so this node makes sure the keyword index exists. It is idempotent: re-creating an existing index is a no-op. On the very first run against a brand-new collection it may fail because the collection does not exist yet — that is fine, the insert step creates the collection and every later run will create the index."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('KB Config — EDIT ME').item.json.qdrantUrl }}/collections/{{ $('KB Config — EDIT ME').item.json.collection }}/points/delete?wait=true",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "qdrantApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filter: { must: [ { key: 'metadata.doc_title', match: { value: $('KB Config — EDIT ME').item.json.doc_title } } ] } }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "58d781ab-c678-40f5-b813-411ba3161809",
      "name": "Remove Previous Version",
