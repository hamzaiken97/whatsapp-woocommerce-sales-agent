    {
      "parameters": {
        "jsCode": "// The vector store emits one item per stored chunk. Report the upload back\n// to the person who submitted the form as a single readable result.\nconst cfg = $('KB Config — EDIT ME').first().json;\n\nreturn [{\n  json: {\n    status: 'stored',\n    document: cfg.doc_title,\n    category: cfg.category,\n    chunks_stored: $input.all().length,\n    collection: cfg.collection,\n    uploaded_at: cfg.uploaded_at,\n    message: 'Uploaded. The assistant can now answer questions from this document.',\n  },\n}];"
      },
      "id": "e94e35d9-ad64-4430-824c-3d2b3ae7bdaa",
      "name": "Upload Summary",
      "type": "n8n-nodes-base.code",
