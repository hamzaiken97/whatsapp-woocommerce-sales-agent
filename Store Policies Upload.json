          "id": "hr9diS9lk4umgh9s",
          "name": "Qdrant account"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Deletes any chunks previously stored under the same document title so re-uploading a document replaces it instead of duplicating it. Needs the keyword index on metadata.doc_title (created by the previous node)."
    },
    {
